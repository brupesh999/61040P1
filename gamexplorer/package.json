{
  "overrides": {
    "bson": "7.2.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.7.0",
    "vue": "^3.5"
  },
  "devDependencies": {
    "typescript": ">=6 <7",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "start": "bun src/main.ts",
    "preview": "bun run db:up && bun scripts/local.ts preview",
    "start:backend": "bun scripts/local.ts",
    "start:frontend": "HOST=127.0.0.1 PORT=${WEB_PORT:-8080} BACKEND_URL=http://127.0.0.1:${API_PORT:-3000} bun web/server.ts",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --watch scripts/local.ts",
    "dev:frontend": "HOST=127.0.0.1 PORT=${WEB_PORT:-8080} BACKEND_URL=http://127.0.0.1:${API_PORT:-3000} bun --watch web/server.ts",
    "up": "podman compose up -d --build && bun scripts/check-api.ts http://127.0.0.1:${WEB_PORT:-8080} --wait",
    "down": "podman compose down",
    "logs": "podman compose logs backend frontend",
    "seed:demo": "bun scripts/seed-demo.ts",
    "seed:catalog": "bun scripts/seed-catalog.ts",
    "db:up": "podman compose up -d --wait mongo",
    "db:shell": "podman compose exec mongo mongosh -u dev -p dev",
    "db:logs": "podman compose logs mongo",
    "db:reset": "podman compose down -v",
    "test": "bun test --timeout 20000"
  },
  "name": "gamexplorer"
}
